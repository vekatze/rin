{
  target {
    test {
      main "_test.nt",
      build-option [
        "$(pkg-config libcurl --libs --cflags)",
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  zen {
    build-option [
      "$(pkg-config libcurl --libs --cflags)",
    ],
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --libs --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "AV5wq2fmffFFvabWuGMEgHXG-jXf543FE_rDYNlWxm0",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.9.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "s9j-KeBMkdz04vn-yg-DERlmchNcyUk1hJ6nkAtZ1B8",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.4.tar.zst",
      ],
    },
  },
}
