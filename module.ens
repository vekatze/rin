{
  target {
    test {
      main "_test.nt",
      build-option [
        "$(pkg-config libcurl --libs --cflags)",
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  zen {
    build-option [
      "$(pkg-config libcurl --libs --cflags)",
    ],
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --libs --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "TH_ZYK-tPe5GL9kkKTfyl5YcjTLU7H-iDY1XooPu0bg",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.56.0.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "ePahlJQnFuwgMjz4Ulj2mAoEJxdXUmYMljl8GROy-8o",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.0.tar.zst",
      ],
    },
  },
}
