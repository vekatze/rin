{
  target {
    test {
      main "_test.nt",
      build-option [
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    link [
      "context/foreign.o",
    ],
    transitive-link-option [
      "$(pkg-config libcurl --libs)",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "-hD_dy56xnr7w2oe-S8ZduK0_ccKID6Y0wuvi_VfqKQ",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.11.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "uSpyzaWPPCj6JKBF1gb2Q8mtw6obA4fQr0WXs9baV6g",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.6.tar.zst",
      ],
    },
  },
}
