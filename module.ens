{
  target {
    test {
      main "_test.nt",
      build-option [
        "$(pkg-config libcurl --libs --cflags)",
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  zen {
    build-option [
      "$(pkg-config libcurl --libs --cflags)",
    ],
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --libs --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "n0NMzM59PRpPonVCdVhFRLGv2XUa1w9lZmyzFk5OvJM",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0-55-26.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "5qyYlHI962HGNtOIW33eAw3kTQtUtRbnyBE64duK5wc",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0-1-52.tar.zst",
      ],
    },
  },
}
