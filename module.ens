{
  target {
    test {
      main "_test.nt",
      build-option [
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    link [
      "context/foreign.o",
    ],
    transitive-link-option [
      "$(pkg-config libcurl --libs)",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "y_tXrgTua-N3029uEirZRTdGbOVWnwcO8IjX7QqiW1U",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.9.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "AHhuhD99W8GfoWc9FQx-A-9gNQsNB-yYa5laez-WBqs",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.4.tar.zst",
      ],
    },
  },
}
