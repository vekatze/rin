{
  target {
    test {
      main "_test.nt",
      build-option [
        "$(pkg-config libcurl --libs --cflags)",
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  zen {
    build-option [
      "$(pkg-config libcurl --libs --cflags)",
    ],
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --libs --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "v5ZueFMAkJl9q3gU5dHupMJr5Wb30PHzmcDgL8_padI",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.56.1.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "HqgMPPYYyA_Rz_UJ6Cb8n4lg4kWf9ATvg8gARTKUUug",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.2.tar.zst",
      ],
    },
  },
}
