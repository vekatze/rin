{
  target {
    test {
      main "_test.nt",
      build-option [
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  foreign [
    {
      platform "${0}/${0}",
      input [
        "source/_context/foreign.c",
      ],
      output [
        "context/foreign.o",
      ],
      link [
        "context/foreign.o",
      ],
      transitive-link-option [
        "$(pkg-config libcurl --libs)",
      ],
      script [
        "{{clang}} $(pkg-config libcurl --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
      ],
    },
  ],
  dependency {
    core {
      digest "U0di-DrJSIaBBKq1kVsSzQNp_DedAAcKQQxv_HRP7Rg",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.12.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "YpnKnSbuT3d_3NOPwpEqvx-QoI21UXfDS8biU6_g-6k",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.7.tar.zst",
      ],
    },
  },
}
