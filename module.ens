{
  target {
    test {
      main "_test.nt",
      build-option [
        "$(pkg-config libcurl --libs --cflags)",
        // AddressSanitizer might report memory leaks in `curl_global_init` on macOS
        // (cf. https://stackoverflow.com/a/37770799)
        "-fsanitize=address",
      ],
    },
  },
  zen {
    build-option [
      "$(pkg-config libcurl --libs --cflags)",
    ],
  },
  foreign {
    input [
      "source/_context/foreign.c",
    ],
    output [
      "context/foreign.o",
    ],
    script [
      "{{clang}} $(pkg-config libcurl --libs --cflags) -c -flto=thin -O2 source/_context/foreign.c -o {{foreign}}/context/foreign.o",
    ],
  },
  dependency {
    core {
      digest "XfFV2TbkGgQbBv9N7WgZbP4J9QIE8NO9e2o9YhtmyVA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.8.tar.zst",
      ],
      enable-preset true,
    },
    http-base {
      digest "KJfjx35Dp3X_vBK3vkeb4mgxddpB26ScX-O1OrcY2qc",
      mirror [
        "https://github.com/vekatze/http-base-nt/raw/main/archive/0.2.3.tar.zst",
      ],
    },
  },
}
